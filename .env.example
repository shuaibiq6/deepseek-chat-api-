# ===== DeepSeek Chat API 环境配置示例 =====
# 复制为 .env 并按需修改：cp .env.example .env

# --- 本服务对外鉴权（客户端请求需携带 X-API-Key 请求头）---
API_KEY=your-api-key

# --- 数据库（本地 Docker MySQL）---
DATABASE_URL=mysql+aiomysql://deepseek:deepseek@localhost:3306/deepseek_chat
# 启动时自动建表（开发便捷）；生产建议关闭并使用 Alembic 迁移
AUTO_CREATE_TABLES=true

# --- DeepSeek 上游配置（OpenAI 兼容协议）---
# 官方 API：https://api.deepseek.com
# 本地 vLLM / Ollama 等兼容服务：如 http://localhost:8001/v1
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_API_BASE=https://api.deepseek.com
# 本地 R1 部署可改为：deepseek-r1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# --- 调试开关 ---
DEBUG=false
